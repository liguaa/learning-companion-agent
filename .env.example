# Copy this file to .env. Existing process environment variables take priority.
# auto selects DeepSeek for deepseek-* model names; otherwise OpenAI.
# Explicit values: auto, deepseek, openai.
LLM_PROVIDER=auto
LLM_MODEL=
LLM_API_KEY=
# Optional; leave empty to use the selected provider's default endpoint.
# DeepSeek default: https://api.deepseek.com
# DeepSeek model example from current official docs: deepseek-flash
LLM_BASE_URL=
# DeepSeek only: disabled for responsive tutoring; enabled for thinking mode.
DEEPSEEK_THINKING=disabled
# Optional HTTP(S) proxy address, e.g. http://127.0.0.1:<your actual HTTP proxy port>.
# Leave empty when not needed. This is separate from the model API base URL.
LLM_PROXY_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1500

# Relative paths resolve against the project directory, not the current shell directory.
DATABASE_PATH=data/learning.db
# Approximate token threshold; tune for the chosen model's context window.
CONTEXT_SUMMARY_TOKENS=6000
CONTEXT_KEEP_MESSAGES=6
MAX_INPUT_CHARS=6000

# Local full-text search works without an embedding service or extra key.
KB_SEARCH_MODE=keyword
KB_CHUNK_SIZE=900
KB_CHUNK_OVERLAP=120
# Optional: set KB_SEARCH_MODE=hybrid to combine full-text and semantic search.
# Configure an independent OpenAI-compatible embedding service; chat keys are not reused.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Local disposable Linux containers; no network or host mounts during code execution.
# Configure Docker Desktop's image-download proxy separately, not LLM_PROXY_URL.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_OUTPUT_BYTES=8000
